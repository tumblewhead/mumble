  "verdict": "accepted_narrow_fixed_public_shape_control",
  "blocking_findings": [],
  "findings": [
    {
      "id": "ARCH-R1-ISOLATION",
      "disposition": "accepted",
      "reason": "public_queries takes public calibration prior mean and fixed perturbations before stimulus creation. Truth stays in generator recipe, outside accumulator, query selection, centering, objective and correction. No posterior feedback."
    },
    {
      "id": "ARCH-R1-JOINT",
      "disposition": "accepted",
      "reason": "All78 upper-triangle entries of12-column affine residual root are retained, including all11-amplitude cross terms and residual constant. compose transports right block from original origin before stacked QR and adds normalizers once. Source identity and contiguous chronology prevent duplicate block insertion."
    },
    {
      "id": "ARCH-R1-PRIOR",
      "disposition": "accepted_for_declared_scope",
      "reason": "Comparisons are prior-free likelihoods at common physical queries. Original chart prior cost could add identically at each query; no amplitude Gaussian prior, normalized conditional density or marginal posterior is computed. Future probability calculations must explicitly preserve transformed prior measure/Jacobian and gamma/Q coupling."
    },
    {
      "id": "ARCH-R1-DERIVATIVE",
      "disposition": "accepted",
      "reason": "Fixed gamma/Q derivative has dlogQ/dq=dloggamma_plus/dq=dloggamma_minus/dq=-1/q. eta derivatives match atanh(B/H). Direct reference propagates complete16-by11 derivative with F through chronological blocks. Full J.T@J is the fixed-shape affine amplitude Hessian."
    },
    {
      "id": "ARCH-R1-TRANSPORT",
      "disposition": "accepted",
      "reason": "Actual rows and durations propagate signed-current RC, directional hysteresis, thermal factors and charge in order. Endpoint comparison uses identical11-amplitude coordinates, and charge extrema enforce SOC support. Variable-temperature finite witnesses are not an extension of R0 constant-temperature interval proof."
    },
    {
      "id": "ARCH-R1-CONTAINMENT",
      "disposition": "accepted_with_scope",
      "reason": "Block construction, numerical work and finite checks precede retained-state commit. Invalid source/order/observation or QR failure leave history unchanged. Snapshot copies mutable arrays. Acceptance is ordinary synchronous Python containment, not crash/concurrency or arbitrary-range numerical certification."
    },
    {
      "id": "ARCH-R1-STORAGE",
      "disposition": "accepted_conditional_accounting",
      "reason": "Tested binary64 root624B+response72B+shape40B+scalar32B=768B numeric retained payload per fixed public shape. Calibration/source/config/Python objects, dense QR/block scratch, prior/optimizer and unknown-shape history are excluded. Host timing sums three conditional factors against one H7 field with different Python/native kernels; no target speedup follows."
    },
    {
      "id": "ARCH-R1-ABS-PRECISION",
      "disposition": "resolved_before_receipt",
      "reason": "Initial run.py omitted absolute precision norm despite specification. Author added only scaled_precision_error_norm=np.linalg.norm(dP), preserved all initial sources and pilot001, and reran unchanged protocol to pilot002. Reviewed exact one-line diff, new source binding, both pilots and reran11 targeted tests. All54 pilot002 gates pass."
    },
    {
      "id": "ARCH-R1-FINITE-LIMIT",
      "disposition": "explicit_limit",
      "reason": "Public-query finite arithmetic gates do not establish posterior fidelity near fitted optima, application SOC/Q budgets, calibrated coverage, uniform response bounds or continuous-shape memory. H7 approximation deviations are measured without applying the fixed-shape acceptance gates."
    }
  ],
